---
import "./ripnel.css";
import MainLayout from "../../layouts/MainLayout.astro";
import SiteNavigation from "../../components/shared/SiteNavigation.astro";
import Footer from "../../components/shared/Footer.astro";
import CaseScreen from "../../components/projects/CaseScreen.astro";
import CaseLightbox from "../../components/projects/CaseLightbox.astro";
import ActionLink from "../../components/shared/ActionLink.astro";
import TechChip from "../../components/shared/TechChip.astro";
import { profile } from "../../content/profile";
import { ripnelProject as project, ripnelScreens, ripnelMobile } from "../../content/ripnel";
import { asset } from "../../utils/assets";
const sections = [{ id: "contexto", label: "Qué hace el sistema" }, { id: "aporte", label: "Qué desarrollé" }, { id: "producto", label: "Recorridos del sistema" }, { id: "arquitectura", label: "Arquitectura" }, { id: "decisiones", label: "Decisiones técnicas" }, { id: "calidad", label: "Pruebas y estado actual" }];
---
<MainLayout title={`${project.name} · Proyecto de desarrollo de software | ${profile.name}`} description={`${project.summary} Mi aporte, recorridos y decisiones técnicas en un proyecto propio.`} ogImage="og/ripnel-og.png" ogAlt="RIPNEL Platform: proyecto propio de desarrollo de software de Nelson Jhon Gil Pari, con una captura del ERP textil.">
  <div class="page-shell case-page">
    <SiteNavigation brandHref={asset("#top")} brandImage="/brand/nj-logo.png" brandAlt="Nelson Nejigiku · Volver al inicio" links={[{ href: asset("#projects"), label: "Todos los proyectos" }, { href: "#producto", label: "Ver recorrido" }, { href: asset("#contact"), label: "Contacto" }]} />
    <main id="main-content" tabindex="-1">
      <header class="case-hero case-container">
        <ActionLink className="case-back" appearance="text" href={asset("#ripnel-platform")} label="Volver a proyectos" kind="secondary" iconName="arrow-left" />
        <p class="case-eyebrow">Proyecto propio · Desarrollo de software</p>
        <h1>{project.name}</h1>
        <p class="case-lead">{project.summary}</p>
        <dl class="case-facts">
          <div><dt>Mi aporte</dt><dd>Diseño de flujos, interfaz, API y base de datos</dd></div>
          <div><dt>Contexto</dt><dd>Gestión textil entre ubicaciones</dd></div>
          <div><dt>Código</dt><dd>Repositorio privado</dd></div>
        </dl>
        <div class="case-actions"><ActionLink href="#producto" label="Ver recorrido" kind="projects" icon="trailing" iconName="arrow-down" /><ActionLink appearance="text" href={profile.contact.cvEs} label={profile.contactCvLabel} kind="cv" icon="trailing" iconName="external-link" /></div>
        <div id="venta-en-mostrador"><CaseScreen {...ripnelScreens[0]} caption="El punto de venta reúne productos, variantes, cantidades y cobro. La captura muestra una venta en borrador con datos sintéticos; no se confirmó la operación." eager /></div>
        <p class="case-source">Capturas reales del ERP en un entorno local aislado, con datos sintéticos. Octubre de 2026.</p>
      </header>
      <div class="case-container case-body">
        <aside class="case-toc" aria-label="Contenido del caso">
          <details open><summary>En este caso</summary><nav aria-label="Secciones del caso" data-case-toc>{sections.map(section => <a href={`#${section.id}`}>{section.label}</a>)}</nav></details>
        </aside>
        <div class="case-story">
          <section id="contexto" class="case-section">
            <p class="case-eyebrow">01 / Contexto</p><h2>Qué hace el sistema</h2>
            <p>RIPNEL permite registrar ventas, consultar stock por ubicación y gestionar caja y transferencias. Los accesos dependen del rol del usuario.</p>
            <p>Es un proyecto propio de desarrollo de software. Esta página presenta mi trabajo en el ERP; ripnel.com es la web de la marca.</p>
          </section>
          <section id="aporte" class="case-section">
            <p class="case-eyebrow">02 / Desarrollo</p><h2>Qué desarrollé</h2>
            <div class="case-grid">
              <article><span>Diseño</span><h3>Requerimientos y flujos</h3><p>Definí los recorridos de venta, caja y transferencias, sus estados y las acciones disponibles para cada rol.</p></article>
              <article><span>Implementación</span><h3>Frontend, API y datos</h3><p>Desarrollé las pantallas en Next.js, la API en Express y el modelo PostgreSQL, con autorización y transacciones en el backend.</p></article>
              <article><span>Verificación</span><h3>Pruebas y CI</h3><p>Preparé pruebas de interfaz e integración, comprobaciones en GitHub y documentación para los despliegues manuales.</p></article>
            </div>
            <p class="case-secondary">Trabajo con asistencia de herramientas de IA durante el desarrollo. La responsabilidad sobre las decisiones, la revisión y la validación del proyecto es mía.</p>
          </section>
          <section id="producto" class="case-section">
            <p class="case-eyebrow">03 / Interfaz</p><h2>Recorridos del sistema</h2>
            <p>Capturas del ERP agrupadas por tarea. Puedes abrir cada grupo y ampliar las imágenes.</p>
            <details class="case-journey" open>
              <summary><span><strong>Preparar una venta</strong><span>Consultar productos y revisar caja antes de pasar al punto de venta.</span></span></summary>
              <div class="case-journey-body">
                <p>El catálogo muestra productos, variantes y precios. Caja permite revisar su apertura y las operaciones de la sesión.</p>
                <ActionLink appearance="text" href="#venta-en-mostrador" label="Ver el punto de venta mostrado al inicio" kind="secondary" icon="trailing" iconName="arrow-up" />
                <CaseScreen {...ripnelScreens[1]} />
                <CaseScreen {...ripnelScreens[4]} />
              </div>
            </details>
            <details class="case-journey">
              <summary><span><strong>Consultar y trasladar existencias</strong><span>Revisar stock por ubicación y preparar una solicitud de transferencia.</span></span></summary>
              <div class="case-journey-body">
                <p>Inventario muestra el stock por ubicación. Las transferencias tienen etapas de solicitud, despacho y recepción; la captura corresponde a una solicitud en borrador.</p>
                <CaseScreen {...ripnelScreens[2]} />
                <CaseScreen {...ripnelScreens[3]} caption="Solicitud en borrador entre ubicaciones ficticias. La captura no acredita un despacho ni una recepción completados." />
              </div>
            </details>
            <details class="case-journey">
              <summary><span><strong>Navegar según la sesión</strong><span>Encontrar las tareas disponibles en escritorio y móvil.</span></span></summary>
              <div class="case-journey-body">
                <p>El inicio muestra las tareas disponibles según los permisos de la sesión.</p>
                <CaseScreen {...ripnelScreens[5]} />
                <CaseScreen {...ripnelMobile} label="Vista móvil" mobile />
              </div>
            </details>
          </section>
          <section id="arquitectura" class="case-section">
            <p class="case-eyebrow">04 / Estructura</p><h2>Arquitectura</h2>
            <div class="case-architecture" role="img" aria-label="El navegador ERP Next.js consulta la API Express mediante HTTP. La API autoriza y ejecuta transacciones en PostgreSQL. La web pública es independiente. Staging, DEMO temporal y producción aceptan releases por separado.">
              <div class="architecture-row"><div><small>Interfaz</small><strong>ERP · Next.js</strong><span>Sesión y tareas</span></div><span aria-hidden="true"><img src={asset("/icons/lucide--arrow-right.svg")} alt="" /></span><div><small>Dominio</small><strong>API · Express</strong><span>Permisos y reglas</span></div><span aria-hidden="true"><img src={asset("/icons/lucide--arrow-right.svg")} alt="" /></span><div><small>Persistencia</small><strong>PostgreSQL</strong><span>Integridad y transacciones</span></div></div>
              <div class="architecture-separate"><strong>Web pública</strong><span>Contenido e identidad propios · publicación independiente</span></div>
              <div class="architecture-destinations"><span>Staging</span><span>DEMO temporal</span><span>Producción</span></div>
              <p>Promociones manuales · aceptación independiente por destino</p>
            </div>
            <p>La interfaz consulta la API, que valida permisos y reglas de inventario, precios y caja antes de modificar datos. El frontend no consulta PostgreSQL. Cada entorno se valida por separado antes de un despliegue manual.</p>
            <ul class="case-stack" aria-label="Tecnologías del proyecto">{project.stack.map(item => <li><TechChip item={item} variant="project" /></li>)}</ul>
          </section>
          <section id="decisiones" class="case-section">
            <p class="case-eyebrow">05 / Implementación</p><h2>Decisiones técnicas</h2>
            <article class="case-decision"><span>01</span><div><h3>Autorizar en el backend</h3><p><strong>Problema:</strong> ocultar un botón no impide ejecutar una acción.</p><p><strong>Decisión:</strong> validar sesión y permisos en la API; la interfaz refleja las acciones disponibles.</p><p><strong>Coste:</strong> mantener contratos y probar tanto la experiencia permitida como la denegación.</p></div></article>
            <article class="case-decision"><span>02</span><div><h3>Tratar cada operación como una unidad</h3><p><strong>Problema:</strong> una venta o transferencia puede afectar varios registros relacionados.</p><p><strong>Decisión:</strong> centralizar las reglas y las transacciones en el backend y PostgreSQL.</p><p><strong>Coste:</strong> contemplar estados, integridad y operaciones simultáneas, también cuando una acción falla.</p></div></article>
            <article class="case-decision"><span>03</span><div><h3>Separar integrar de desplegar</h3><p><strong>Problema:</strong> aprobar un cambio de código no demuestra que esté listo para todos los entornos.</p><p><strong>Decisión:</strong> comprobar en GitHub lo afectado en cada propuesta de cambio y ejecutar una verificación completa en main. Los despliegues son manuales y usan una versión identificada.</p><p><strong>Coste:</strong> registrar las comprobaciones y validar esa versión en el entorno de destino antes de habilitarla.</p></div></article>
          </section>
          <section id="calidad" class="case-section">
            <p class="case-eyebrow">06 / Verificación</p><h2>Pruebas y estado actual</h2>
            <div class="case-evidence"><h3>Pruebas de desarrollo</h3><p>La base revisada incluye pruebas unitarias y pruebas de interfaz con APIs simuladas. Otra comprobación recorre inicio de sesión, identidad, permisos, consulta de productos y cierre de sesión con el frontend compilado, la API y PostgreSQL reales.</p><p>Estas pruebas cubren comportamientos concretos; no certifican por sí solas todos los procesos del ERP.</p></div>
            <div class="case-evidence"><h3>Acceso y disponibilidad</h3><p>ERP desarrollado, con repositorio privado y despliegues manuales. Este caso ofrece capturas y documentación de la implementación; el acceso al ERP no es público.</p><p>Una futura DEMO reducida queda por definir, separada de la capacitación existente y de la web ripnel.com.</p></div>
            <details class="case-provenance"><summary>Procedencia y límites de la evidencia</summary><div><p>Capturas del código de referencia <code>4019c10</code>, ejecutado localmente el 22 de octubre de 2026 con el frontend compilado, la API y PostgreSQL 17 descartable. Todos los registros son sintéticos. La venta y la solicitud de transferencia son borradores.</p><p>Las imágenes acreditan estas vistas del sistema, no datos de clientes, adopción ni impacto comercial. La capacitación existente requiere autenticación y un entorno DEMO temporal; no implica disponibilidad pública.</p></div></details>
          </section>
        </div>
      </div>
      <nav class="case-contact case-container" id="case-contact" aria-label="Continuar desde el caso"><ActionLink href={asset("#contact")} label="Contacto" kind="contact" icon="trailing" /><ActionLink appearance="text" href={profile.contact.cvEs} label={profile.contactCvLabel} kind="cv" icon="trailing" iconName="external-link" /><ActionLink appearance="text" href={asset("#ripnel-platform")} label="Volver a proyectos" kind="secondary" icon="trailing" iconName="arrow-left" /></nav>
    </main>
    <Footer name={profile.name} />
    <CaseLightbox />
    <script>
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-case-toc] a"));
      const sections = links.map(link => ({ link, section: document.getElementById(link.hash.slice(1)) })).filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => item.section !== null);
      let queued = false;
      const markCurrent = () => {
        queued = false;
        const anchor = (document.querySelector("[data-site-nav]")?.getBoundingClientRect().bottom ?? 60) + 40;
        let active = sections[0];
        for (const item of sections) { if (item.section.getBoundingClientRect().top <= anchor) active = item; }
        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4) active = sections.at(-1) ?? active;
        for (const item of sections) {
          if (item === active) item.link.setAttribute("aria-current", "location");
          else item.link.removeAttribute("aria-current");
        }
      };
      const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(markCurrent); } };
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule);
      window.addEventListener("hashchange", schedule);
      document.querySelectorAll(".case-journey").forEach(group => group.addEventListener("toggle", schedule));
      markCurrent();
    </script>
  </div>
</MainLayout>
