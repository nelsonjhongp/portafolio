---
import { Image } from "astro:assets";
import "./ProjectGallery.css";
import type { Project } from "../../types/portfolio";
interface Props { project: Project }
const { project } = Astro.props;
const screens = project.screens?.length ? project.screens : [{ src: project.image, alt: `Vista previa de ${project.name}`, label: "Vista general" }];
---
<div class="project-visual-shell" role="group" data-project-gallery aria-label={`Capturas de ${project.name}`}>
  <div class="project-visual">
    {screens.map((screen, index) => (
      <div class="project-screen" data-project-screen hidden={index !== 0} data-screen-label={screen.label}>
        {typeof screen.src === "string" ? <img src={screen.src} alt={screen.alt} loading="lazy" /> :
          <Image src={screen.src} alt={screen.alt} widths={[480, 960]} sizes="(max-width: 760px) 100vw, 560px" format="webp" quality={80} loading="lazy" />}
      </div>
    ))}
  </div>
  {screens.length > 1 && <div class="project-gallery-controls" hidden data-gallery-controls>
    <button type="button" data-gallery-prev aria-label={`Captura anterior de ${project.name}`}>←</button>
    <span data-gallery-label aria-live="polite">1 / {screens.length} · {screens[0].label}</span>
    <button type="button" data-gallery-next aria-label={`Captura siguiente de ${project.name}`}>→</button>
  </div>}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-project-gallery]").forEach(gallery => {
    const screens = Array.from(gallery.querySelectorAll<HTMLElement>("[data-project-screen]"));
    const controls = gallery.querySelector<HTMLElement>("[data-gallery-controls]");
    const label = gallery.querySelector<HTMLElement>("[data-gallery-label]");
    if (screens.length < 2 || !controls || !label) return;
    controls.hidden = false;
    let index = 0;
    const show = (next: number) => {
      index = (next + screens.length) % screens.length;
      screens.forEach((screen, i) => screen.hidden = i !== index);
      label.textContent = `${index + 1} / ${screens.length} · ${screens[index].dataset.screenLabel}`;
    };
    gallery.querySelector("[data-gallery-prev]")?.addEventListener("click", () => show(index - 1));
    gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => show(index + 1));
  });
</script>
