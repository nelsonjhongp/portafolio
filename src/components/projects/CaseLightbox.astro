---
import { asset } from "../../utils/assets";
---
<dialog class="case-lightbox" aria-labelledby="lightbox-title" data-case-lightbox>
  <div class="lightbox-toolbar">
    <h2 id="lightbox-title" aria-live="polite">Captura de RIPNEL</h2>
    <div class="lightbox-controls">
      <button type="button" data-lightbox-prev aria-label="Captura anterior" title="Captura anterior"><img class="lightbox-arrow-back" src={asset("/icons/lucide--arrow-right.svg")} alt="" /></button>
      <button type="button" data-lightbox-next aria-label="Captura siguiente" title="Captura siguiente"><img src={asset("/icons/lucide--arrow-right.svg")} alt="" /></button>
      <a data-lightbox-original target="_blank" rel="noreferrer" aria-label="Abrir imagen completa en otra pestaña" title="Abrir imagen completa en otra pestaña"><img src={asset("/icons/lucide--external-link.svg")} alt="" /></a>
      <button type="button" data-lightbox-close aria-label="Cerrar visor" title="Cerrar visor" autofocus><img src={asset("/icons/lucide--x.svg")} alt="" /></button>
    </div>
  </div>
  <div class="lightbox-stage" data-lightbox-stage aria-busy="false">
    <p role="status" data-lightbox-status></p>
    <img data-lightbox-image alt="" hidden />
  </div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-case-lightbox]");
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-case-image]"));
  const image = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const stage = dialog?.querySelector<HTMLElement>("[data-lightbox-stage]");
  const status = dialog?.querySelector<HTMLElement>("[data-lightbox-status]");
  const title = dialog?.querySelector<HTMLElement>("#lightbox-title");
  const original = dialog?.querySelector<HTMLAnchorElement>("[data-lightbox-original]");
  if (dialog && image && stage && status && title && original && links.length) {
    let index = 0, selection = 0, previousOverflow = "";
    let opener: HTMLAnchorElement | undefined;
    let pending: HTMLImageElement | undefined;
    const fit = () => {
      const link = links[index];
      const width = Number(link.dataset.caseWidth) || 1440;
      const height = Number(link.dataset.caseHeight) || 1000;
      const availableWidth = Math.max(1, window.innerWidth - 50);
      const toolbarHeight = dialog.querySelector(".lightbox-toolbar")?.getBoundingClientRect().height || 44;
      const availableHeight = Math.max(1, window.innerHeight - 58 - toolbarHeight);
      const scale = Math.min(1, availableWidth / width, availableHeight / height);
      dialog.style.setProperty("--viewer-width", `${Math.max(Math.min(320, availableWidth), width * scale)}px`);
      dialog.style.setProperty("--capture-width", `${width * scale}px`);
      dialog.style.setProperty("--capture-height", `${height * scale}px`);
    };
    const clearPending = () => {
      if (pending) { pending.onload = null; pending.onerror = null; pending = undefined; }
    };
    const show = (next: number) => {
      clearPending();
      index = (next + links.length) % links.length;
      const current = ++selection;
      const link = links[index];
      title.textContent = link.dataset.caption ?? "Captura de RIPNEL";
      original.href = link.href;
      image.hidden = true;
      image.removeAttribute("src");
      status.hidden = false;
      status.textContent = "Cargando captura…";
      stage.setAttribute("aria-busy", "true");
      dialog.dataset.state = "loading";
      fit();
      const loaded = new Image();
      pending = loaded;
      const fail = () => {
        if (current !== selection || !dialog.open) return;
        status.textContent = "No se pudo cargar la captura. Puedes abrir la imagen completa o cambiar de captura.";
        stage.setAttribute("aria-busy", "false");
        dialog.dataset.state = "error";
        pending = undefined;
      };
      loaded.onerror = fail;
      loaded.onload = async () => {
        try { await loaded.decode(); } catch { fail(); return; }
        if (current !== selection || !dialog.open) return;
        image.src = loaded.src;
        image.alt = link.querySelector("img")?.alt ?? title.textContent ?? "Captura de RIPNEL";
        image.hidden = false;
        status.hidden = true;
        stage.setAttribute("aria-busy", "false");
        dialog.dataset.state = "ready";
        pending = undefined;
      };
      loaded.src = link.href;
    };
    links.forEach((link, i) => {
      link.setAttribute("aria-haspopup", "dialog");
      link.addEventListener("click", event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        previousOverflow = document.documentElement.style.overflow;
        show(i);
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
        fit();
      });
    });
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => {
      ++selection;
      clearPending();
      document.documentElement.style.overflow = previousOverflow;
      opener?.focus();
    });
    dialog.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(index - 1));
    dialog.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(index + 1));
    dialog.addEventListener("keydown", event => {
      if (event.key === "Tab") {
        const controls = Array.from(dialog.querySelectorAll<HTMLElement>("button, a[href]"));
        const first = controls[0], last = controls.at(-1);
        if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
        else if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      }
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") { event.preventDefault(); show(index + (event.key === "ArrowRight" ? 1 : -1)); }
    });
    window.addEventListener("resize", () => { if (dialog.open) fit(); });
  }
</script>
