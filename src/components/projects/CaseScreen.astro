---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { asset } from "../../utils/assets";
interface Props { src: ImageMetadata; alt: string; label: string; caption?: string; eager?: boolean; mobile?: boolean; placement?: "hero" | "story" }
const { src, alt, label, caption, eager = false, mobile = false, placement = "story" } = Astro.props;
const full = await getImage({ src, format: "webp", quality: 85 });
const sizes = mobile ? "(max-width: 352px) calc(100vw - 72px), 280px" : placement === "hero" ? "(min-width: 1152px) 598px, (min-width: 1024px) calc(55vw - 35px), calc(100vw - 32px)" : "(min-width: 700px) 610px, calc(100vw - 72px)";
---
<figure class:list={["case-screen", mobile && "case-screen-mobile"]}>
  <a href={full.src} data-case-image data-caption={label} data-case-width={src.width} data-case-height={src.height} aria-label={`Ver captura: ${label}`}>
    <Image src={src} alt={alt} widths={mobile ? [390] : [480, 960, 1440]} sizes={sizes} format="webp" quality={80} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} />
    <span class="case-screen-zoom" aria-hidden="true">Ver captura <img src={asset("/icons/lucide--external-link.svg")} alt="" /></span>
  </a>
  <figcaption><strong>{label}</strong>{caption && <span>{caption}</span>}</figcaption>
</figure>
