---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: ImageMetadata; alt: string; label: string; caption?: string; eager?: boolean; mobile?: boolean }
const { src, alt, label, caption, eager = false, mobile = false } = Astro.props;
const full = await getImage({ src, format: "webp", quality: 85 });
---
<figure class:list={["case-screen", mobile && "case-screen-mobile"]}>
  <a href={full.src} data-case-image data-caption={label} aria-label={`Ampliar: ${label}`}>
    <Image src={src} alt={alt} widths={mobile ? [390] : [480, 960, 1440]} sizes={mobile ? "(max-width: 480px) 90vw, 390px" : "(max-width: 1152px) 94vw, 1120px"} format="webp" quality={80} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} />
    <span class="case-screen-zoom" aria-hidden="true">Ampliar ↗</span>
  </a>
  <figcaption><strong>{label}</strong>{caption && <span>{caption}</span>}</figcaption>
</figure>
